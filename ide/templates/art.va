# Night city - generative art drawn with code (no animation, just one frame).
# Every run is a slightly different city. Run it a few times!

canvas(480, 360)
clear("#0a0a18")

import "random"

# stars
repeat 70 times
    color(choice(["#ffffff", "#cfc8ff", "#9aa3ff"]))
    rect(random(0, 478), random(0, 200), 2, 2)
end

# the moon, with a soft glow
color("#241f45")
circle(390, 60, 42)
color("#3a3370")
circle(390, 60, 34)
color("#f3efff")
circle(390, 60, 26)

# skyline
let x be 0
while x is under 480
    let width be random(36, 64)
    let height be random(80, 200)
    let top be 360 - height
    color(choice(["#181430", "#1d1840", "#221c4c"]))
    rect(x, top, width, height)

    # lit windows
    let wy be top + 10
    while wy is under 348
        let wx be x + 6
        while wx is under x + width - 8
            if chance(38)
                color(choice(["#ffd166", "#ffe9b3", "#b388ff"]))
                rect(wx, wy, 5, 7)
            end
            change wx to wx + 11
        end
        change wy to wy + 14
    end
    change x to x + width + random(2, 10)
end

# ground line
color("#b388ff")
rect(0, 358, 480, 2)

color("#e7e3f5")
text_at(12, 24, "night city - generated by Vanta", 15)
say "Drew a brand new city. Run again for a different one!"
