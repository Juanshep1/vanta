# trainer.va — a game memory trainer ("cheat"), written in Vanta.
#
# This is the same workflow as Cheat Engine or a pymem script in Python, but in
# Vanta: find the game's process, scan its memory for a value you can see on
# screen (health, gold, ammo), narrow it down as the value changes, then WRITE
# or FREEZE that address.
#
# Editing your OWN process works with no special permission. Editing ANOTHER
# program needs privileges: run with `sudo vanta trainer.va` (and on macOS,
# System Integrity Protection may still block it). For single-player / offline
# games — online games have anti-cheat and editing them breaks their terms.

# --- 1. find the game ---
let pid be find_pid("MyGame")          # the process name (try process_list() to list them)
if pid is 0
    say "Game not found. Running processes:"
    for each p in process_list()
        say "  " + text(p["pid"]) + "  " + p["name"]
    end
    stop
end
say "Attached to " + text(pid)

# --- 2. find the value (the Cheat-Engine narrow-down) ---
# Suppose your health on screen is 100 right now:
let hits be mem_scan(pid, 100)
say text(length(hits)) + " addresses currently hold 100"

# Take some damage so health becomes (say) 80, then keep only the addresses
# that changed to 80. Repeat with new values until one address is left.
#   change hits to mem_next(pid, hits, 80)
#   change hits to mem_next(pid, hits, 65)
# (for decimals use the "float" kind: mem_scan(pid, 99.5, "float"))

# --- 3. cheat it ---
# Once one address remains, it's your health:
#   let addr be hits[0]
#   write_int(pid, addr, 999)            # set it once
#   let lock be freeze(pid, addr, 999)   # OR lock it forever (infinite health)
#   ... play the game ...
#   unfreeze(lock)                       # release the lock

# --- 4. on/off hotkeys (like the Python trainers) ---
# Give the cheat a toggle key. on_hotkey runs a function each time the key is
# pressed, even while the game has focus. (macOS: grant your terminal
# Accessibility / Input-Monitoring permission the first time.)
#
#   let health_addr be hits[0]
#   let lock be 0
#   let is_on be no
#   to toggle_health()
#       if is_on
#           unfreeze(lock)
#           change is_on to no
#           say "infinite health OFF"
#       otherwise
#           change lock to freeze(pid, health_addr, 999)
#           change is_on to yes
#           say "infinite health ON"
#       end
#   end
#   on_hotkey("f1", toggle_health)        # tap F1 to toggle
#   on_hotkey("f2", make give write_int(pid, gold_addr, 99999))   # F2 = max gold
#   say "Trainer running. F1 = infinite health, F2 = max gold. Ctrl-C to quit."
#   while yes
#       sleep(1)                          # keep alive so the hotkeys keep working
#   end

# Other tools:
#   read_int(pid, addr)          read a 4-byte integer (also read_float, read_mem)
#   write_float(pid, addr, 1.0)  write a float (also write_int, write_mem)
#   mem_regions(pid)             list the readable memory regions
#   my_pid()                     this program's own pid (safe to test on)
#   key_pressed("f1")            is a key currently held down?
#   wait_key("f1")               block until a key is pressed
#   press_key("space")           simulate a key press   (key_down / key_up to hold)
#   type_text("hello")           type a string
#   mouse_move(x, y)             move the cursor   (mouse_click / mouse_pos)
