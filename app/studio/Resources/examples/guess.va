# A number-guessing game: random numbers + input + a loop

let secret be random(1, 10)
let tries be 0
let won be no

say "I'm thinking of a number from 1 to 10."

while won is no
    ask "Your guess?" into guess
    change tries to tries + 1
    if guess is secret
        say "Correct! You got it in " + tries + " tries."
        change won to yes
    otherwise if guess is under secret
        say "Too low. Try higher."
    otherwise
        say "Too high. Try lower."
    end
end
