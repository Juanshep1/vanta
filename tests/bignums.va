# Whole numbers never overflow: they just get bigger (in native builds too).
to factorial(n)
    if n is at most 1
        give back 1
    end
    give back n * factorial(n - 1)
end
say factorial(20)
say factorial(25)
say factorial(30)
let big be 2 ^ 100
say big
say big + 1
say big - big
say big * big
say big / 1024
say big / 3
say big % 1000007
say -big
say -big % 7
say 9223372036854775807 + 1
say -9223372036854775808 - 1
say 99999999999999999999999
say big > 2 ^ 99
say big is 2 ^ 100
say big is not 2 ^ 100 + 1
say big < 1.5
say big + 0.5
say text(big) + "!"
say length(text(factorial(50)))
say number("123456789012345678901234567890") + 1
say sort([2 ^ 70, 5, 2 ^ 65, -(2 ^ 80)])
say max([2 ^ 64, 3])
say abs(-(2 ^ 70))
say 1 << 70
say (2 ^ 70) >> 60
say is_number(big)
say type_of(big)
let m be {}
change m at 2 ^ 64 to "big key"
say m[2 ^ 64]
let total be 1
for each i in range(1, 40)
    change total to total * i
end
say total
say "{big:,}"
